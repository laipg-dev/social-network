{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "local-development-secret-key-at-least-32-characters",
    "Issuer": "SocialNetwork",
    "Audience": "SocialNetwork",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "Storage": {
    "RootPath": "uploads",
    "RequestPath": "/uploads"
  },
  "Email": {
    "Enabled": true,
    "FromName": "Social Network",
    "FrontendBaseUrl": "http://localhost:3000"
  }
}
